# OpenAlex requires a free API key as of Feb 2026 and uses daily usage-based credits.
# Get one at https://openalex.org (account settings) — free tier gives ~$1.00/day credit.
OPENALEX_API_KEY=
# Contact email identifies you to OpenAlex (recommended, not billed).
OPENALEX_MAILTO=you@example.com

# Optional: raises Semantic Scholar's shared rate limit. Get one at
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# Required for `search` (decomposes the paper into 5 keyword sets) and
# `chat` (the chatbot's model) -- no other API key needed anywhere in this
# project. Install Ollama (ollama.com), make sure it's running, and pull
# the model:
#   ollama pull llama3.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# How many months before a stored scholar record is considered stale
# and re-fetched from OpenAlex/Semantic Scholar.
SCHOLAR_STALENESS_MONTHS=6

# Soft warning threshold (USD) for OpenAlex's daily usage-based credit.
OPENALEX_DAILY_BUDGET_WARNING=1.00
